# This file has no real secrets. Inject OAUTH_CLIENT_SECRET from a local secret
# manager, your shell, or deployment configuration; never commit a real value.
OAUTH_ISSUER=http://127.0.0.1:8000
OAUTH_KEY_DIRECTORY=keys
OAUTH_RESOURCE_AUDIENCE=agent-resource
OAUTH_DATABASE_URL=postgresql://oauth:oauth@127.0.0.1:5433/oauth
OAUTH_ACCESS_TOKEN_TTL_SECONDS=600
OAUTH_CLIENT_ID=reporting-agent
OAUTH_CLIENT_SUBJECT=agent:reporting
OAUTH_CLIENT_SCOPES="finance:read reports:read"
OAUTH_CLIENT_AUDIENCES="agent-resource"
OAUTH_CLIENT_SECRET=replace-with-a-long-random-secret
